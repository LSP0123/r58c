+
+	/* ODM: drive GPIO3_D4 high */
+	gpio3_d4_high: gpio3-d4-high {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&gpio3_d4_pin>;
+		regulator-always-on;
+		regulator-name = "gpio3_d4_high";
+		status = "okay";

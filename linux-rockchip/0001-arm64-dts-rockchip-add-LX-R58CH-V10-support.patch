+	usb_detect: usb-detect {
+		compatible = "usb,detect";
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_detect_irq &occharge_irq &pgcharge_irq>;
+		usb-detect-irq = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
+		occharge-irq = <&gpio3 RK_PA1 GPIO_ACTIVE_LOW>;
+		pgcharge-irq = <&gpio3 RK_PC7 GPIO_ACTIVE_HIGH>;
+		status = "okay";

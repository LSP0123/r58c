+/*--------------- UART ---------------*/
+
+/* UART0 (GPIO0_D1/D2, ODM usage) */
+/*
+ * Debug console mux fix: the shared rk3588-linux.dtsi routes the
+ * fiq-debugger to the UART2 M0 pins (GPIO0_B5/B6), but this board's
+ * serial header is wired to the M2 pins (GPIO3_B1/B2) - the same
+ * routing our board U-Boot uses. Without this override the kernel
+ * steals the M0 pins at fiq_debugger probe time and the port goes
+ * silent right after "Starting kernel ...".
+ */
+&fiq_debugger {
+	pinctrl-0 = <&uart2m2_xfer>;
+};
+
+/*
+ * UART0 (ODM usage): explicitly route to the M2 pins (GPIO4_A3/A4),
+ * matching the stock firmware. The 6.1 SoC dtsi defaults to
+ * uart0m1_xfer (GPIO0_B0/B1) - its B1 pin is the SPI2 chip-select
+ * (spi2m2_cs0) that talks to the RK806 PMIC; with the default mux the
+ * pin request collides, SPI2 fails to probe and the whole PMIC (and
+ * everything powered by it: eDP panel, GPU, CPU DVFS) stays down.
+ */
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0m2_xfer>;
+	status = "okay";
+};

+		regulator-name = "vcc_2v8_en";
+		regulator-always-on;
+	};
+
+	vcc3v3_edp: vcc3v3-edp {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc3v3_edp_en>;
+		regulator-name = "vcc3v3_edp";

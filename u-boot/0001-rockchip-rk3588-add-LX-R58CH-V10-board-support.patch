+# Persistent U-Boot environment on eMMC (saveenv support).
+# The Android-flavoured reference configs default to nowhere (misc/BCB
+# flow), so plain saveenv prints "Saving Environment to nowhere...".
+# Store a 32 KiB env blob at the 1 MiB mark of eMMC (dev 0): clear of the
+# idbloader at 32 KiB and of u-boot.itb at 8 MiB, and below the boot
+# partition that starts at 16 MiB.
+CONFIG_CMD_SAVEENV=y
+CONFIG_ENV_IS_IN_MMC=y
+CONFIG_SYS_MMC_ENV_DEV=0
+CONFIG_ENV_SIZE=0x8000
+CONFIG_ENV_OFFSET=0x100000
